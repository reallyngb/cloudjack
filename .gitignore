.venv/
venv/
env/
ENV/

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# --- Test and coverage artefacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Type checker / linter caches ---
.mypy_cache/
.ruff_cache/

# --- Editor / OS files ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

